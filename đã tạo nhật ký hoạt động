<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,Helvetica,sans-serif;
}
body{background:#f4f7f8;color:#1f2937}
a{text-decoration:none;color:inherit}
.app{display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{
  width:250px;background:#0f5132;color:#fff;
  position:fixed;left:0;top:0;bottom:0;
  padding:24px 16px;overflow-y:auto;
}
.logo{
  font-size:28px;font-weight:800;
  text-align:center;margin-bottom:28px;
}
.logo span{color:#ffc107}
.menu-title{
  font-size:12px;text-transform:uppercase;
  opacity:.7;margin:20px 12px 8px;
}
.menu-item{
  display:block;padding:12px 14px;
  border-radius:10px;margin-bottom:6px;
}
.menu-item:hover,.menu-item.active{
  background:rgba(255,255,255,.15);
}

/* MAIN */
.main{
  margin-left:250px;
  width:calc(100% - 250px);
}
.topbar{
  background:#fff;min-height:72px;
  display:flex;justify-content:space-between;
  align-items:center;padding:16px 28px;
  border-bottom:1px solid #e5e7eb;
  position:sticky;top:0;z-index:10;
}
.topbar h1{font-size:22px;color:#0f5132}

.btn{
  border:none;border-radius:10px;
  padding:11px 16px;cursor:pointer;
  font-weight:700;
}
.btn-primary{background:#198754;color:#fff}
.btn-light{background:#eef3f0;color:#0f5132}

.content{
  padding:28px;
  max-width:1400px;
  margin:auto;
}

/* HEADER */
.intro{
  background:linear-gradient(135deg,#0f5132,#198754);
  color:#fff;border-radius:18px;
  padding:24px;margin-bottom:22px;
}
.intro h2{margin-bottom:8px}
.intro p{opacity:.9;line-height:1.6}

/* STATS */
.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;margin-bottom:22px;
}
.stat{
  background:#fff;border-radius:14px;
  padding:20px;border:1px solid #e8ece9;
  box-shadow:0 4px 16px rgba(0,0,0,.05);
}
.stat-icon{font-size:25px;margin-bottom:10px}
.stat strong{
  display:block;font-size:26px;
  color:#0f5132;margin-bottom:4px;
}
.stat span{font-size:13px;color:#6b7280}

/* CARD */
.card{
  background:#fff;border-radius:16px;
  border:1px solid #e8ece9;
  box-shadow:0 4px 18px rgba(0,0,0,.05);
  overflow:hidden;
}
.card-head{
  padding:18px 20px;
  border-bottom:1px solid #edf0f2;
}
.card-head h3{
  color:#0f5132;margin-bottom:15px;
}

/* FILTER */
.filters{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:10px;
}
.control{
  width:100%;padding:11px 12px;
  border:1px solid #d1d5db;
  border-radius:9px;background:#fff;
  outline:none;
}
.control:focus{
  border-color:#198754;
  box-shadow:0 0 0 3px rgba(25,135,84,.08);
}

/* TABLE */
.table-wrap{overflow-x:auto}
table{
  width:100%;border-collapse:collapse;
  min-width:1050px;
}
th,td{
  padding:14px 16px;
  border-bottom:1px solid #edf0f2;
  text-align:left;font-size:14px;
  vertical-align:middle;
}
th{
  background:#f8faf9;
  font-size:13px;color:#374151;
}
tr:hover td{background:#fbfdfc}

.user{
  display:flex;
  align-items:center;
  gap:10px;
}
.avatar{
  width:38px;height:38px;
  border-radius:50%;
  display:flex;align-items:center;
  justify-content:center;
  background:#dff3e7;
  color:#0f5132;font-weight:800;
}
.user strong{display:block}
.user small{color:#6b7280}

.badge{
  display:inline-block;
  padding:6px 10px;
  border-radius:999px;
  font-size:12px;font-weight:700;
}
.order{background:#dbeafe;color:#1d4ed8}
.vehicle{background:#e0f2fe;color:#0369a1}
.money{background:#fef3c7;color:#92400e}
.security{background:#ede9fe;color:#5b21b6}
.account{background:#fce7f3;color:#9d174d}

.success{background:#d1fae5;color:#065f46}
.warning{background:#fef3c7;color:#92400e}
.failed{background:#fee2e2;color:#991b1b}

.description{
  max-width:300px;
  line-height:1.5;
}

.empty{
  display:none;
  padding:35px;
  text-align:center;
  color:#6b7280;
}

/* RESPONSIVE */
@media(max-width:1000px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .filters{grid-template-columns:1fr 1fr}
}
@media(max-width:700px){
  .sidebar{position:static;width:100%}
  .app{display:block}
  .main{margin-left:0;width:100%}
  .content{padding:16px}
  .stats{grid-template-columns:1fr}
  .filters{grid-template-columns:1fr}
}
