<script>

function filterLogs(){

  const search =
    document.getElementById("search")
    .value.toLowerCase();

  const employee =
    document.getElementById("employee")
    .value.toLowerCase();

  const type =
    document.getElementById("type")
    .value.toLowerCase();

  const rows =
    document.querySelectorAll(
      "#logTable tbody tr"
    );

  let visible = 0;

  rows.forEach(function(row){

    const text =
      row.textContent.toLowerCase();

    const matchSearch =
      text.includes(search);

    const matchEmployee =
      employee === "" ||
      text.includes(employee);

    const matchType =
      type === "" ||
      text.includes(type);

    if(
      matchSearch &&
      matchEmployee &&
      matchType
    ){
      row.style.display = "";
      visible++;
    }
    else{
      row.style.display = "none";
    }

  });

  document.getElementById("empty")
    .style.display =
    visible === 0 ? "block" : "none";

}

</script>

