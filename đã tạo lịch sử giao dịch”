}

.filters{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.control{
  padding:10px 12px;
  border:1px solid #d1d5db;
  border-radius:9px;
  background:white;
  outline:none;
}

.search{
  min-width:280px;
}

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:1200px;
}

th,
td{
  padding:14px 16px;
  border-bottom:1px solid #edf0f2;
  text-align:left;
  font-size:14px;
  vertical-align:middle;
}

th{
